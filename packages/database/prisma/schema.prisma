  allocatedAt          DateTime @default(now()) @map("allocated_at") @db.Timestamptz
  status               String   @default("ACTIVE") @db.VarChar(20) // ACTIVE, REVERSED
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  collection        Collection         @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  refundAllocations RefundAllocation[]

  @@index([tenantId])
  @@index([collectionId])
  @@index([paymentInstallmentId])
  @@map("payment_allocations")
}

model FinancialLedgerEntry {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  institutionId       String   @map("institution_id") @db.Uuid
  entryNumber         BigInt   @map("entry_number")
  financialAccountId  String   @map("financial_account_id") @db.Uuid
  entryType           String   @map("entry_type") @db.VarChar(50) // MONEY_IN, MONEY_OUT, TRANSFER_IN, TRANSFER_OUT
  amountMinor         BigInt   @map("amount_minor")
  currency            String   @default("TRY") @db.VarChar(10)
  sourceReferenceType String   @map("source_reference_type") @db.VarChar(50) // COLLECTION, REFUND, REVERSAL, TRANSFER, ADJUSTMENT
  sourceReferenceId   String   @map("source_reference_id") @db.Uuid
  description         String   @db.VarChar(255)
  isReversed          Boolean  @default(false) @map("is_reversed")
  reversalEntryId     String?  @map("reversal_entry_id") @db.Uuid
  postedAt            DateTime @default(now()) @map("posted_at") @db.Timestamptz

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, entryNumber], map: "uq_ledger_tenant_entry_number")
  @@index([tenantId])
  @@index([institutionId])
  @@index([financialAccountId])
  @@index([postedAt])
  @@map("financial_ledger_entries")
}

model Receipt {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  institutionId     String   @map("institution_id") @db.Uuid
  collectionId      String   @map("collection_id") @db.Uuid
  receiptNumber     String   @map("receipt_number") @db.VarChar(100)
  recipientPersonId String   @map("recipient_person_id") @db.Uuid
  amountMinor       BigInt   @map("amount_minor")
  currency          String   @default("TRY") @db.VarChar(10)
  documentReference String?  @map("document_reference") @db.VarChar(255)
  status            String   @default("ISSUED") @db.VarChar(20) // ISSUED, CANCELLED
  issuedAt          DateTime @default(now()) @map("issued_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, receiptNumber], map: "uq_receipts_tenant_number")
  @@index([tenantId])
  @@index([institutionId])
  @@index([collectionId])
  @@map("receipts")
}

model Refund {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  institutionId     String    @map("institution_id") @db.Uuid
  collectionId      String    @map("collection_id") @db.Uuid
  amountMinor       BigInt    @map("amount_minor")
  currency          String    @default("TRY") @db.VarChar(10)
  reason            String    @db.Text
  status            String    @default("REQUESTED") @db.VarChar(20) // REQUESTED, APPROVED, PROCESSING, COMPLETED, FAILED, CANCELLED
  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  approvedByUserId  String?   @map("approved_by_user_id") @db.Uuid
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  refundedAt        DateTime? @map("refunded_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  collection  Collection         @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  allocations RefundAllocation[]

  @@index([tenantId])
  @@index([institutionId])
  @@index([collectionId])
  @@map("refunds")
}

model RefundAllocation {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  refundId            String   @map("refund_id") @db.Uuid
  paymentAllocationId String   @map("payment_allocation_id") @db.Uuid
  amountMinor         BigInt   @map("amount_minor")
  status              String   @default("ACTIVE") @db.VarChar(20) // ACTIVE, REVERSED
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  refund            Refund            @relation(fields: [refundId], references: [id], onDelete: Restrict)
  paymentAllocation PaymentAllocation @relation(fields: [paymentAllocationId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([refundId])
  @@index([paymentAllocationId])
  @@map("refund_allocations")
}

model ReconciliationSession {
