model FinancialAccount {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  name          String   @db.VarChar(100)
  accountType   String   @map("account_type") @db.VarChar(50) // CASH, BANK, CARD_CLEARING, PAYMENT_PROVIDER_CLEARING, OTHER
  currency      String   @default("TRY") @db.VarChar(10)
  accountNumber String?  @map("account_number") @db.VarChar(100)
  iban          String?  @db.VarChar(50)
  bankName      String?  @map("bank_name") @db.VarChar(100)
  branchName    String?  @map("branch_name") @db.VarChar(100)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  collections   Collection[]
  ledgerEntries FinancialLedgerEntry[]

  @@index([tenantId])
  @@index([institutionId])
  @@map("financial_accounts")
}

model Collection {
  id                           String   @id @default(uuid()) @db.Uuid
  tenantId                     String   @map("tenant_id") @db.Uuid
  institutionId                String   @map("institution_id") @db.Uuid
  financialResponsiblePersonId String   @map("financial_responsible_person_id") @db.Uuid
  financialAccountId           String   @map("financial_account_id") @db.Uuid
  paymentMethod                String   @map("payment_method") @db.VarChar(50) // CASH, BANK_TRANSFER, CREDIT_CARD, DIRECT_DEBIT, OTHER
  amountMinor                  BigInt   @map("amount_minor")
  currency                     String   @default("TRY") @db.VarChar(10)
  collectedAt                  DateTime @map("collected_at") @db.Timestamptz
  referenceNumber              String?  @map("reference_number") @db.VarChar(100)
  status                       String   @default("PENDING") @db.VarChar(50) // PENDING, CONFIRMED, PARTIALLY_REFUNDED, REFUNDED, REVERSED, FAILED
  notes                        String?  @db.Text
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  financialAccount FinancialAccount    @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  allocations      PaymentAllocation[]
  receipts         Receipt[]
  refunds          Refund[]

  @@index([tenantId])
  @@index([institutionId])
  @@index([financialResponsiblePersonId])
  @@index([status])
  @@map("collections")
}

model PaymentAllocation {
  id                   String   @id @default(uuid()) @db.Uuid
