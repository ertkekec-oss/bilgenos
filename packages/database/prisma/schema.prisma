  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([assetId])
  @@index([employeeId])
  @@index([status])
  @@map("asset_custodies")
}

model AssetTransfer {
