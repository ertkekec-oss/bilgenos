  @@index([tenantId])
  @@index([financialAccountId])
  @@map("reconciliation_sessions")
}

model ReconciliationItem {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  sessionId            String   @map("session_id") @db.Uuid
